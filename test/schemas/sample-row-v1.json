{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sample-row-v1",
  "title": "SampleRowV1",
  "type": "object",
  "required": [
    "chainId",
    "network",
    "bucket",
    "txHash",
    "tokenAddress",
    "poolAddress",
    "poolCreatedAt",
    "discoverySource",
    "txSource",
    "collectedAt",
    "fallbackUsed"
  ],
  "properties": {
    "chainId": { "type": "integer", "enum": [8453, 56] },
    "network": { "type": "string", "enum": ["base", "bsc"] },
    "bucket": { "type": "string", "enum": ["new", "old"] },
    "txHash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
    "tokenAddress": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "poolAddress": { "type": "string", "minLength": 10 },
    "poolCreatedAt": { "type": "string", "format": "date-time" },
    "discoverySource": {
      "type": "array",
      "items": { "type": "string", "enum": ["gecko", "dexscreener"] },
      "minItems": 1
    },
    "txSource": {
      "type": "string",
      "enum": ["gecko_trades", "free_rpc", "etherscan_v2", "bscscan", "basescan", "mixed"]
    },
    "collectedAt": { "type": "string", "format": "date-time" },
    "fallbackUsed": { "type": "boolean" },
    "tradeKind": { "type": "string" },
    "blockTimestamp": { "type": ["string", "null"], "format": "date-time" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
