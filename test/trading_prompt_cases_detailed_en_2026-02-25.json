[
  {
    "id": "buy_001_same_chain_quote_confirm_execute",
    "intent": "TRADING",
    "title": "Buy contract token on same chain with quote-before-execution path",
    "scenario": "User buys token by contract address on Base. Preferences require quote first.",
    "inputs": {
      "turns": [
        { "role": "user", "content": "Buy 0.01 ETH to 0xAbCdEf0123456789aBCdEf0123456789abCDef0 on Base." },
        { "role": "user", "content": "Confirm." }
      ],
      "context_blocks": {
        "CONTEXT": { "chainId": 8453, "chainName": "Base" },
        "WALLET_STATE": { "ETH": "0.50", "USDC": "120.00", "native_for_gas_ok": true, "stale": false },
        "USER_PREFERENCES_MODULE": {
          "fastSwapMode": false,
          "showQuoteBeforeSwap": true,
          "checkTokenBeforeSwap": true,
          "slippageMode": "custom",
          "customSlippage": 0.5,
          "mevProtection": true,
          "priceDeviationCheck": true
        },
        "LAUNCHPAD_CONTEXT": { "present": false }
      }
    },
    "required_context_usage": [
      "Use CONTEXT.chainId and chainName for chain lock",
      "Use WALLET_STATE for amount and gas feasibility",
      "Use USER_PREFERENCES_MODULE to enforce quote-first flow"
    ],
    "expected_tool_plan": {
      "allowed_sequence": ["get_token_info", "check_token_risk", "simulate_swap", "prepare_swap_transaction"],
      "tool_constraints": [
        "Do not call wallet overview if WALLET_STATE already satisfies chain/token needs",
        "Do not call prepare_swap_transaction in the same turn as simulate_swap when quote-first is enabled",
        "After user confirmation, do not re-run simulate_swap without new constraints"
      ]
    },
    "checkpoints": [
      {
        "name": "identity_lock",
        "pass_if": "Token identity resolved on Base without symbol ambiguity",
        "if_fail": "Ask targeted clarification and stop execution"
      },
      {
        "name": "funds_and_gas",
        "pass_if": "ETH >= 0.01 and native_for_gas_ok=true",
        "if_fail": "Return blocking reason and smallest corrective next action"
      },
      {
        "name": "risk_gate",
        "pass_if": "Risk scan returns non-blocking status",
        "if_fail": "Warn + ask whether to proceed or adjust"
      },
      {
        "name": "quote_then_confirm",
        "pass_if": "Quote shown and explicit confirmation received",
        "if_fail": "Wait for confirmation without executing"
      }
    ],
    "error_matrix": [
      {
        "error_code": "quote_timeout",
        "trigger_signal": "simulate_swap timeout/unavailable/no data",
        "assistant_must": [
          "State temporary quote unavailability",
          "Offer retry or amount adjustment",
          "Avoid blind same-call loops"
        ],
        "assistant_must_not": ["Fabricate quote values", "Claim execution success"]
      },
      {
        "error_code": "prepare_failed",
        "trigger_signal": "prepare_swap_transaction returns route/execution error",
        "assistant_must": [
          "Return failure reason + current state + next minimum action",
          "Keep user in-app flow by default"
        ],
        "assistant_must_not": ["Say trade succeeded without receipt"]
      }
    ],
    "output_contract": {
      "must_include": ["Base", "0.01 ETH", "confirmation", "receipt identifier on success"],
      "must_avoid": ["internal tool names", "executed successfully before receipt"]
    }
  },
  {
    "id": "sell_001_fast_mode_direct_execution",
    "intent": "TRADING",
    "title": "Sell token with fastSwapMode enabled",
    "scenario": "User sells USDC to ETH and requests immediate action.",
    "inputs": {
      "turns": [
        { "role": "user", "content": "Sell 150 USDC to ETH now." }
      ],
      "context_blocks": {
        "CONTEXT": { "chainId": 8453, "chainName": "Base" },
        "WALLET_STATE": { "USDC": "400.00", "ETH": "0.03", "native_for_gas_ok": true, "stale": false },
        "USER_PREFERENCES_MODULE": {
          "fastSwapMode": true,
          "showQuoteBeforeSwap": true,
          "checkTokenBeforeSwap": false,
          "slippageMode": "auto"
        }
      }
    },
    "required_context_usage": [
      "Respect fastSwapMode=true as primary execution hint",
      "Validate sell amount and gas feasibility from WALLET_STATE"
    ],
    "expected_tool_plan": {
      "allowed_sequence": ["prepare_swap_transaction"],
      "tool_constraints": [
        "Do not force quote-first blocking under fastSwapMode=true",
        "Do not skip safety-critical checks (balance/gas/chain)"
      ]
    },
    "error_matrix": [
      {
        "error_code": "insufficient_usdc",
        "trigger_signal": "requested sell amount > WALLET_STATE.USDC",
        "assistant_must": ["Block and show mismatch", "Request corrected amount"],
        "assistant_must_not": ["Auto-change amount without user consent"]
      }
    ],
    "output_contract": {
      "must_include": ["150 USDC", "ETH"],
      "must_avoid": ["unnecessary simulation blocking"]
    }
  },
  {
    "id": "buy_002_chain_mismatch_switch_gate",
    "intent": "TRADING",
    "title": "Buy request where wallet chain and token chain mismatch",
    "scenario": "User is on Base but token context resolves to Arbitrum.",
    "inputs": {
      "turns": [
        { "role": "user", "content": "Buy 0.01 ETH to 0xTokenOnArbitrum." }
      ],
      "context_blocks": {
        "CONTEXT": { "chainId": 8453, "chainName": "Base" },
        "TOKEN_CONTEXT": { "chainId": 42161, "chainName": "Arbitrum", "address": "0xTokenOnArbitrum" },
        "WALLET_STATE": { "ETH": "0.30", "native_for_gas_ok": true }
      }
    },
    "required_context_usage": [
      "Use TOKEN_CONTEXT chain as authority for token chain when provided",
      "Do not infer chain from 0x format alone"
    ],
    "expected_tool_plan": {
      "allowed_sequence": ["get_token_info"],
      "tool_constraints": [
        "Ask chain-switch question before preparing trade",
        "No execution on current chain when mismatch exists"
      ]
    },
    "error_matrix": [
      {
        "error_code": "user_declines_switch",
        "trigger_signal": "User explicitly refuses chain switch",
        "assistant_must": [
          "Stop trade path",
          "Offer minimal alternatives (switch later / choose same-chain asset)"
        ],
        "assistant_must_not": ["Execute on wrong chain"]
      }
    ],
    "output_contract": {
      "must_include": ["Base", "Arbitrum", "switch"],
      "must_avoid": ["auto execute on wrong chain"]
    }
  },
  {
