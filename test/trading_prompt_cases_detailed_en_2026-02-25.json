        "WALLET_STATE": { "USDC": "500.00", "ETH": "0.01", "native_for_gas_ok": true },
        "USER_PREFERENCES_MODULE": { "fastSwapMode": false, "showQuoteBeforeSwap": true }
      },
      "simulated_tool_results": {
        "simulate_swap": { "status": "timeout", "error": "upstream_quote_timeout" }
      }
    },
    "required_context_usage": ["Respect quote-first requirement before execution"],
    "expected_tool_plan": {
      "allowed_sequence": ["simulate_swap"],
      "tool_constraints": ["Stop repeated same-call retries after limit"]
    },
    "error_matrix": [
      {
        "error_code": "quote_unavailable",
        "trigger_signal": "simulate_swap timeout/unavailable/no data",
        "assistant_must": [
          "Mark quote as temporarily unavailable",
          "Offer retry or adjust amount/slippage",
          "Avoid execution claim"
        ],
        "assistant_must_not": ["Fabricate quote"]
      }
    ],
    "output_contract": {
      "must_include": ["temporarily unavailable", "retry"],
      "must_avoid": ["made-up quote"]
    }
  },
