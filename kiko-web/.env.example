# KIKO App Environment Variables
# Copy this file to .env and fill in your actual values

# AI Integration
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Blockchain RPC
VITE_INFURA_API_KEY=your_infura_api_key_here
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# 0x API
VITE_ZEROX_API_KEY=your_0x_api_key_here

# Data Sources
VITE_DEXSCREENER_API_KEY=your_dexscreener_api_key_here
VITE_DEFILLAMA_API_KEY=your_defillama_api_key_here
VITE_COINGECKO_API_KEY=your_coingecko_api_key_here

# Privy (Wallet)
VITE_PRIVY_APP_ID=your_privy_app_id
VITE_PRIVY_APP_SECRET=your_privy_app_secret

# Database (if needed)
VITE_DATABASE_URL=your_database_url_here
VITE_REDIS_URL=your_redis_url_here

# Server
VITE_PORT=3000
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_ANALYTICS=false
