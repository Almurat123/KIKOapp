{
  "name": "kiko-api",
  "version": "1.0.0",
  "description": "KIKO Backend API Service",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,python \"tsx watch src/index.ts\" \"cd ../kiko-python && python3 main.py\"",
    "build": "prisma generate && tsc",
    "postinstall": "test -f prisma/schema.prisma && prisma generate || echo 'Skipping prisma generate (schema not found)'",
    "start": "node dist/index.js",
    "test": "tsx --test",
    "migrate": "tsx src/db/migrate.ts",
    "diagnostic:db": "node dist/scripts/diagnostic-db.js",
    "refresh-market-data": "tsx src/scripts/refreshMarketData.ts",
    "kill-port": "bash scripts/kill-port.sh",
    "dev:clean": "npm run kill-port && npm run dev",
    "python": "cd ../kiko-python && python3 main.py",
    "dev:all": "npm run dev",
    "sec:runtime": "tsx scripts/security/runtime-detectors.ts",
    "sec:solana": "tsx scripts/security/solana-detectors.ts",
    "sec:flows": "tsx scripts/security/fund-flows.ts",
    "sec:fingerprints": "tsx scripts/security/bytecode-fingerprint.ts",
    "sec:metrics": "tsx scripts/security/security-metrics.ts",
    "test:tools": "tsx scripts/test-tools.ts",
    "sec:slither": "slither contracts/**/*.sol --exclude-dependencies --json slither.json",
    "sec:myth": "myth analyze contracts/Token.sol --max-depth 50 --solver-timeout 60",
    "sec:fuzz": "forge test --mc TokenTest --ffi",
    "sec:storage": "forge inspect Proxy implementation && forge inspect Impl storage"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.40.0",
    "@duneanalytics/client-sdk": "^0.3.4",
    "@fastify/cors": "^9.0.1",
    "@fastify/env": "^4.2.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^8.3.1",
    "@neynar/nodejs-sdk": "^3.97.0",
    "@paragraph_xyz/sdk": "^0.5.0",
    "@polymarket/clob-client": "^5.1.3",
    "@polymarket/order-utils": "^3.0.1",
    "@prisma/client": "^5.22.0",
    "@privy-io/server-auth": "^1.32.5",
    "@solana/web3.js": "^1.98.4",
    "@types/ws": "^8.18.1",
    "@zoralabs/coins-sdk": "^0.3.3",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "cheerio": "^1.1.2",
    "clanker-sdk": "^4.2.8",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.1",
    "duck-duck-scrape": "^2.2.7",
    "ethers": "^6.15.0",
    "fastify": "^4.26.0",
    "graphql": "^16.12.0",
    "graphql-request": "^7.4.0",
    "hpke-js": "^1.6.5",
    "jose": "^5.10.0",
    "node-cron": "^3.0.3",
    "pg": "^8.11.5",
    "prisma": "^5.22.0",
    "puppeteer": "^24.34.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^4.6.13",
    "resend": "^6.7.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.10.9",
    "concurrently": "^9.2.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}