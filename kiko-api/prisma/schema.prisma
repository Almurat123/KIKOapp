// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User linked to Privy
model User {
  id            String            @id @default(cuid())
  privyDid      String            @unique
  walletAddress String            @unique // Primary EVM address
  solanaWalletAddress String?     // Optional Solana address
  createdAt     DateTime          @default(now())
  configs       CopyTradeConfig[]
  positions     Position[]
  settings      UserSettings?
  walletExports WalletExport[]
  favorites     FavoriteToken[]
  polymarketConfigs PolymarketCopyConfig[]
  polymarketPositions PolymarketPosition[]
}


// Wallet Key Export Record (for compliance tracking)
model WalletExport {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAddress String   // The exported wallet address
  chainType     String   // ethereum | solana
  exportedAt    DateTime @default(now())
  
  @@unique([userId, walletAddress])
  @@index([userId])
}

// User Settings (Custom AI Settings)
model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // User Role
  userRole              String   @default("default")
  
  // Trading Preferences
  defaultSwapAmount     Float    @default(100)
  defaultSwapUnit       String   @default("native")
  checkTokenBeforeSwap  Boolean  @default(true)
  quickSwapMode         Boolean  @default(false)
  swapMethod            String   @default("swap_card")
  
  // Swap Protection
  slippageMode          String   @default("auto")
  customSlippage        Float    @default(0.5)
  mevProtection         Boolean  @default(true)
  priceDeviationCheck   Boolean  @default(true)
  
  // Copy Trade AI
  copyTradeAIMode       String   @default("disabled")
  
  // Fast Swap
  fastSwapMode          Boolean  @default(false)
  
  updatedAt             DateTime @updatedAt
}

// Copy Trade Configuration
model CopyTradeConfig {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Target wallet to follow
  targetWallet    String
  chainId         Int      @default(8453) // Base

  // Buy Settings
  buyAmountUsd    Float    // Fixed USD amount to buy
  maxSlippageBps  Int      @default(300) // 3% default

  // Filters
  minMarketCapUsd Float?   // Minimum market cap filter
  minLiquidityUsd Float?   // Minimum liquidity filter
  minTargetValueUsd Float? // Minimum target tx value to trigger copy

  // Auto Sell Settings
  takeProfitPct   Float?   // Take profit percentage (e.g., 100 = +100%)
  stopLossPct     Float?   // Stop loss percentage (e.g., 20 = -20%)
  mirrorSell      Boolean  @default(true) // Sell when target sells

  status          String   @default("active") // active | paused
  aiAnalysisMode  String   @default("disabled") // disabled, analyze_only, auto_decide
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  analyses        CopyTradeAnalysis[]

  @@index([targetWallet])
  @@index([userId])
}

// Copy Trade AI Analysis History
model CopyTradeAnalysis {
  id              String   @id @default(cuid())
  configId        String
  config          CopyTradeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  
  tokenAddress    String
  tokenSymbol     String
  aiDecision      String   // BUY | SKIP
  confidenceScore Float
  analysisJson    String   // JSON string of full analysis
  
  createdAt       DateTime @default(now())

  @@index([configId])
}

// Tracked Wallet (for efficient monitoring)
model TrackedWallet {
  address       String
  chainId       Int
  lastCheckedTx String?  // Last processed transaction hash
  activeConfigs Int      @default(0) // Count of configs watching this wallet
  updatedAt     DateTime @updatedAt

  @@id([address, chainId])  // Composite primary key: same address can exist on multiple chains
}

// ======== POLYMARKET COPY TRADING ========

// Polymarket Copy Trade Configuration
model PolymarketCopyConfig {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetWallet    String   // Polymarket trader to follow

  // Bet Settings
  betSizeUsd      Float    @default(10) // Fixed bet size per trade
  maxOpenBets     Int      @default(10) // Max concurrent positions

  status          String   @default("active") // active, paused
  mirrorSell      Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  positions       PolymarketPosition[]

  @@index([targetWallet])
  @@index([userId])
}

// Polymarket Position (bet tracking)
model PolymarketPosition {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  configId        String
  config          PolymarketCopyConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  marketSlug      String   // e.g., "will-trump-win-2024"
  conditionId     String   // CTF condition ID
  assetId         String   // Yes/No token ID

  question        String   // "Will Trump win 2024?"
  outcome         String   // "Yes" or "No"

  entryPrice      Float    // e.g., 0.65 (65¢ per share)
  shares          Float    // Number of shares
  costBasis       Float    // Total USD spent

  currentPrice    Float?
  profitLossPct   Float?

  status          String   @default("open") // open, closed, won, lost
  exitReason      String?  // mirror_sell, manual, market_resolved

  createdAt       DateTime @default(now())
  closedAt        DateTime?
  resolvedAt      DateTime?

  @@index([userId])
  @@index([status])
  @@index([conditionId])
}

// Polymarket API Credentials (per-user, encrypted)
// Each user's Privy wallet generates their own CLOB API credentials
model PolymarketApiCreds {
  id              String   @id @default(cuid())
  userId          String   @unique
  
  // Wallet address this credential is for (user's Privy wallet)
  walletAddress   String
  
  // L2 API Credentials (encrypted at rest)
  apiKey          String   // UUID format API key
  apiSecret       String   // Base64 encoded secret
  passphrase      String   // Hex passphrase
  
  // Optional nonce for deriving keys later
  nonce           Int?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([walletAddress])
}

// Position (tracks user's holdings from copy trades)
model Position {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  configId      String

  tokenAddress  String
  tokenSymbol   String?
  chainId       Int

  entryPrice    Float
  entryAmount   String   // Amount in base units
  entryTxHash   String
  entryUsdValue Float

  currentPrice  Float?
  profitLossPct Float?

  exitTxHash    String?
  exitReason    String?  // take_profit | stop_loss | mirror_sell | manual

  status        String   @default("open") // open | closed
  createdAt     DateTime @default(now())
  closedAt      DateTime?

  @@index([userId])
  @@index([status])
  @@index([tokenAddress])
}

// Chat Session for AI Conversations
model ChatSession {
  id           String        @id @default(cuid())
  userId       String
  title        String
  model        String        @default("grok-2-1212")
  status       String        @default("active") // active, archived
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]
  tasks        AITask[]

  @@index([userId])
}

// Chat Message
model ChatMessage {
  id               String         @id @default(cuid())
  sessionId        String
  session          ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role             String         // user | assistant | system | tool
  content          String
  reasoningContent String?
  
  // Metadata & Status
  type             String         @default("text") // text, swap-card, token-card, etc.
  data             String?        @db.Text        // JSON string for card data
  transactionStatus String?       // waiting, success, failed, cancelled
  transactionHash   String?
  citations        String?        // JSON string
  usage            String?        // JSON string (prompt_tokens, completion_tokens, etc.)
  toolCalls        String?        // JSON string
  toolCallId       String?
  messageIndex     Int
  status           String         @default("complete") // streaming, complete, error
  
  createdAt        DateTime       @default(now())
  
  chunks           MessageChunk[]

  @@index([sessionId])
  @@index([messageIndex])
}

// AI Background Task
model AITask {
  id                 String      @id @default(cuid())
  sessionId          String
  session            ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  userMessageId      String?
  assistantMessageId String?
  
  model              String
  status             String      @default("queued") // queued, running, done, error, cancelled
  errorMessage       String?
  
  toolContext        String?     // JSON string
  
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime    @default(now())

  @@index([sessionId])
  @@index([status])
}

// Streaming Message Chunk
model MessageChunk {
  id               Int         @id @default(autoincrement())
  messageId        String
  message          ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  chunkIndex       Int
  chunkType        String      // content, reasoning, tool_call, tool_result, citation
  
  content          String?
  reasoningContent String?
  metadata         String?     // JSON string
  
  createdAt        DateTime    @default(now())

  @@unique([messageId, chunkIndex])
  @@index([messageId])
}

// News Article generated by AI (KIKO News Terminal)
model NewsArticle {
  id              String   @id @default(cuid())
  title           String
  slug            String?  @unique // For URL friendly access
  summary         String?
  content         String   // Markdown content
  
  // Metadata
  coverImage      String?  // URL or path to generated cover image
  tokens          String?  // JSON string of tokens analyzed [{"symbol":"ETH", "chain":"eth", ...}]
  chains          String?  // JSON string of chains involved ["eth", "base", ...]
  
  // Status
  status          String   @default("pending") // pending, approved, rejected, published
  rejectionReason String?
  
  // External
  paragraphId     String?  // ID from Paragraph
  paragraphUrl    String?  // URL to published article
  
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Suggestion Events for Estimation and Verification
model SuggestionEvent {
  id              String   @id @default(cuid())
  userId          String
  // "Input": The data used for detection (heuristic scores or random)
  strategy        String   @default("heuristic") // 'heuristic', 'random', 'ai'
  inputContext    Json?    // Stores scores { "swap": 5, "audit": 0... }
  
  // "Output": The resulting suggestion IDs
  outputResult    Json     // ["swap-tutorial", "deep-audit"...]
  
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Moderation Logs (Input/Output Detection)
model ModerationLog {
  id              String   @id @default(cuid())
  userId          String?  // Optional if we can't always track user
  sessionId       String?  // The chat session ID
  model           String?  // The AI model used
  channel         String   // 'input' or 'output'
  content         String   // Truncated content
  result          Json     // Result from kiko-python
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

// Judge Engine v3.5 Decision Records (for ML/DL Training)
model JudgeDecision {
  id                String   @id @default(cuid())
  
  // Input
  tokenAddress      String
  tokenSymbol       String?
  tokenName         String?
  chainId           Int
  userAmountUsd     Float
  targetWallet      String?  // If from copy trade
  
  // Context
  launchpadType     String
  liquidity         Float
  contractAgeHours  Float
  
  // Layer Outputs (stored as JSON for flexibility)
  userSizeLayer     Json     // L1-L4, scores, reasons
  liquidityLayer    Json     // Slippage, pool depth, decision
  structureLayer    Json     // Launchpad features, LP lock
  stageLayer        Json     // S0-S4, age analysis
  tokenIntelLayer   Json     // 5 sub-modules + aggregated score
  
  // Final Decision
  finalDecision     String   // ALLOW | ALLOW_WITH_RISK | BLOCK
  overallRiskScore  Float    // 0-1
  slippageEstimate  Float    // 0-1
  reasons           Json     // Array of reasons
  aiRationale       String?  @db.Text // Grok-generated decision report
  
  // Full Output (for debugging)
  fullOutputJson    String   @db.Text  // Complete JSON output
  
  // Actual Outcome (for validation and learning)
  actualExecuted    Boolean? // Did user actually execute?
  actualProfitPct   Float?   // If executed, what was the profit/loss?
  actualOutcome     String?  // success | failed | rug | honeypot
  outcomeNotes      String?  // Additional notes
  outcomeUpdatedAt  DateTime?
  
  // Metadata
  analysisTimeMs    Int      // How long analysis took
  createdAt         DateTime @default(now())
  
  @@index([tokenAddress])
  @@index([chainId])
  @@index([finalDecision])
  @@index([createdAt])
}

// User Favorite Tokens
model FavoriteToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain     String
  address   String
  createdAt DateTime @default(now())

  @@unique([userId, chain, address])
  @@index([userId])
}

// PostgreSQL Cache Table (replaces Redis)
model Cache {
  key       String   @id
  value     String   @db.Text
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// Market Overview Data
model MarketOverview {
  id                      Int      @id @default(autoincrement())
  globalMarketCap         Decimal?
  volume24h               Decimal?
  activeUsers             BigInt?
  ethGasPrice             String?  @db.VarChar(50)
  fearGreedIndex          Int?
  fearGreedClassification String?  @db.VarChar(50)
  bitcoinDominance        Decimal?
  altcoinSeasonIndex      Decimal?
  globalOpenInterest      Decimal?
  gasLevel                Decimal?
  gasLevelStatus          String?  @db.VarChar(20)
  bvix                    Decimal?
  evix                    Decimal?
  liquidityStressIndex    Decimal?
  liquidityStressStatus   String?  @db.VarChar(20)
  updatedAt               DateTime @default(now())
  createdAt               DateTime @default(now())

  @@index([updatedAt(sort: Desc)])
}

// Chain Metrics
model ChainMetric {
  id             Int      @id @default(autoincrement())
  name           String   @unique @map("chain_name") @db.VarChar(50)
  tvl            Decimal?
  tvlChange24h   Decimal? @map("tvl_change_24h")
  volume24h      Decimal? @map("volume_24h")
  txns24h        BigInt?  @map("txns_24h")
  poolsCount     Int?     @map("pools_count")
  tokensCount    Int?     @map("tokens_count")
  activeWallets  BigInt?  @map("active_wallets")
  gasPrice       String?  @map("gas_price") @db.VarChar(50)
  contracts24h   Int?
  contracts7d    Int?
  logoUrl        String?  @map("logo_url") @db.Text
  updatedAt      DateTime @default(now()) @updatedAt
  createdAt      DateTime @default(now())

  @@index([updatedAt(sort: Desc)])
}

// Protocol Metrics
model ProtocolMetric {
  id            Int      @id @default(autoincrement())
  name          String   @unique @map("protocol_name") @db.VarChar(100)
  symbol        String?  @map("protocol_symbol") @db.VarChar(20)
  category      String?  @db.VarChar(50)
  tvl           Decimal?
  tvlChange1d   Decimal? @map("tvl_change_1d")
  tvlChange7d   Decimal? @map("tvl_change_7d")
  volume24h     Decimal? @map("volume_24h")
  chains        String[] 
  mcapTvlRatio  Decimal? @map("mcap_tvl_ratio")
  logoUrl       String?  @map("logo_url") @db.Text
  updatedAt     DateTime @default(now()) @updatedAt
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([updatedAt(sort: Desc)])
}

// Trending Token Data
model TrendingToken {
  id              String   @id @default(cuid())
  chain           String   @default("eth")
  address         String
  name            String
  symbol          String
  network         String
  imageUrl        String?  @map("image_url")
  price           Decimal?
  priceChange5m   Decimal? @map("price_change_5m")
  priceChange1h   Decimal? @map("price_change_1h")
  priceChange6h   Decimal? @map("price_change_6h")
  priceChange24h  Decimal? @map("price_change_24h")
  volume24h       Decimal? @map("volume_24h")
  liquidity       Decimal?
  fdv             Decimal?
  rank            Int?
  updatedAt       DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())

  @@unique([chain, address])
  @@index([rank])
  @@index([updatedAt(sort: Desc)])
}

