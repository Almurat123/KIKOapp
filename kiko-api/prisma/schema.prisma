model ai_tasks {
  id                   String        @id @db.VarChar
  session_id           String        @db.VarChar
  user_message_id      String?       @db.VarChar
  assistant_message_id String?       @db.VarChar
  model                String        @db.VarChar
  provider             String?       @db.VarChar
  status               String        @db.VarChar
  error_message        String?
  tool_context         Json?         @db.Json
  cancelled_by         String?       @db.VarChar
  started_at           DateTime?     @db.Timestamp(6)
  completed_at         DateTime?     @db.Timestamp(6)
  created_at           DateTime      @db.Timestamp(6)
  chat_sessions        chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id], map: "ix_ai_tasks_session_id")
}

model chat_messages {
  id                      String           @id @db.VarChar
  session_id              String           @db.VarChar
  role                    String           @db.VarChar
  content                 String
  reasoning_content       String
  usage_json              Json?            @db.Json
  citations_json          Json?            @db.Json
  tool_trace_json         Json?            @db.Json
  provider                String?          @db.VarChar
  provider_request_id     String?          @db.VarChar
  stream_protocol_version String           @db.VarChar
  first_token_ms          Int?
  end_to_end_ms           Int?
  type                    String           @db.VarChar
  status                  String           @db.VarChar
  message_index           Int
  feedback                String?          @db.VarChar
  created_at              DateTime         @db.Timestamp(6)
  chat_sessions           chat_sessions    @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  message_chunks          message_chunks[]

  @@index([session_id], map: "ix_chat_messages_session_id")
}

model chat_sessions {
  id                         String          @id @db.VarChar
  user_id                    String          @db.VarChar
  title                      String          @db.VarChar
  model                      String          @db.VarChar
  status                     String          @db.VarChar
  provider                   String?         @db.VarChar
  last_response_id           String?         @db.VarChar
  compaction_cursor          String?         @db.VarChar
  conversation_state_version Int
  created_at                 DateTime        @db.Timestamp(6)
  updated_at                 DateTime        @db.Timestamp(6)
  ai_tasks                   ai_tasks[]
  chat_messages              chat_messages[]

  @@index([user_id], map: "ix_chat_sessions_user_id")
}

model message_chunks {
  id                Int           @id @default(autoincrement())
  message_id        String        @db.VarChar
  chunk_index       Int
  chunk_type        String        @db.VarChar
  content           String?
  reasoning_content String?
  metadata_json     Json?         @db.Json
  created_at        DateTime      @db.Timestamp(6)
  chat_messages     chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([message_id, chunk_index], map: "idx_message_chunks_message_index")
  @@index([message_id], map: "ix_message_chunks_message_id")
}

model sandbox_artifacts {
  id         String   @id
  task_id    String
  kind       String
  uri        String
  meta       Json?
  created_at DateTime @default(now())
