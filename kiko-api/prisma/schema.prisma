generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CopyTradeConfigStatus {
  active
  paused
}

enum PolymarketConfigStatus {
  active
  paused
}

enum PolymarketPositionStatus {
  open
  closed
  failed
}

enum PolymarketActionStatus {
  pending
  success
  failed
  cancelled
}

enum PositionStatus {
  pending
  open
  closing
  closed
  failed
}

enum SwapHistoryStatus {
  pending
  success
  failed
  confirmed
  cancelled
}

model Chain {
  id          Int      @id
  name        String   @unique
  symbol      String
  rpcUrl      String?
  explorerUrl String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Token {
  id        String   @id @default(cuid())
  chainId   Int
  address   String
  symbol    String
  name      String?
  decimals  Int?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chainId, address])
  @@index([symbol])
}

model User {
  id                  String                 @id @default(cuid())
  privyDid            String                 @unique
  walletAddress       String                 @unique
  solanaWalletAddress String?
  farcasterFid        Int?
  farcasterUsername   String?
  createdAt           DateTime               @default(now())
  email               String?                @unique
  referralCode        String?                @unique
  referredBy          String?
  billingBlocks       BillingBlock[]
  billingConsents     BillingConsent[]
  billingUsage        BillingUsageLedger[]
  chatSessions        ChatSession[]
  configs             CopyTradeConfig[]
  dailyBilling        DailyBilling[]
  favorites           FavoriteToken[]
  polymarketActions   PolymarketAction[]
  polymarketApiCreds  PolymarketApiCreds?
  polymarketConfigs   PolymarketCopyConfig[]
  polymarketPositions PolymarketPosition[]
  positions           Position[]
  settings            UserSettings?
  swapHistory         SwapHistory[]
  userActivities      UserActivity[]
  walletExports       WalletExport[]
}

model WalletExport {
  id            String   @id @default(cuid())
  userId        String
  walletAddress String
  chainType     String
  exportedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, walletAddress])
  @@index([userId])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  // userRole removed
  defaultSwapAmount             Float    @default(100)
  defaultSwapUnit               String   @default("native")
  checkTokenBeforeSwap          Boolean  @default(true)
  quickSwapMode                 Boolean  @default(false)
  swapMethod                    String   @default("allowance_trade")
  slippageMode                  String   @default("auto")
  customSlippage                Float    @default(0.5)
  mevProtection                 Boolean  @default(true)
  priceDeviationCheck           Boolean  @default(true)
  copyTradeAIMode               String   @default("disabled")
  fastSwapMode                  Boolean  @default(false)
  updatedAt                     DateTime @updatedAt
  createdAt                     DateTime @default(now())
  copyTradeTokenCooldownMinutes Int?     @default(60)
  minLiquidityUsd               Float?
  minMarketCapUsd               Float?
  minTargetValueUsd             Float?
  zoraNotificationThreshold     Int?     @default(5000)
  user                          User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)
}

model CopyTradeConfig {
  id                            String                @id @default(cuid())
  userId                        String
  targetWallet                  String
  chainId                       Int                   @default(8453)
  buyAmountUsd                  Float
  maxSlippageBps                Int                   @default(300)
  minMarketCapUsd               Float?
  minLiquidityUsd               Float?
  minTargetValueUsd             Float?
  copyTradeTokenCooldownMinutes Int?
  executionMode                 String                @default("balanced")
  disableTokenInfo              Boolean               @default(false)
  takeProfitPct                 Float?
  stopLossPct                   Float?
  mirrorSell                    Boolean               @default(true)
  enableDynamicTP               Boolean               @default(false)
  dynamicTPMinProfitPct         Float                 @default(100)
  status                        CopyTradeConfigStatus @default(active)
  aiAnalysisMode                String                @default("disabled")
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  analyses                      CopyTradeAnalysis[]
  positions                     Position[]
  user                          User                  @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([targetWallet])
  @@index([userId])
}

model CopyTradeAnalysis {
  id              String          @id @default(cuid())
  configId        String
  tokenAddress    String
  tokenSymbol     String
  aiDecision      String
  confidenceScore Float
  analysisJson    String
  createdAt       DateTime        @default(now())
  config          CopyTradeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}

model TrackedWallet {
  address            String
  chainId            Int
  lastCheckedTx      String?
  activeConfigs      Int       @default(0)
  updatedAt          DateTime  @updatedAt
  lastTradeAt        DateTime?
  nickName           String?
  totalTradesTracked Int       @default(0)
  createdAt          DateTime  @default(now())

  @@id([address, chainId])
}

model PolymarketCopyConfig {
  id           String                 @id @default(cuid())
  userId       String
  targetWallet String
  betSizeUsd   Float                  @default(10)
  maxOpenBets  Int                    @default(10)
  status       PolymarketConfigStatus @default(active)
  mirrorSell   Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  user         User                   @relation(fields: [userId], references: [privyDid], onDelete: Cascade)
  positions    PolymarketPosition[]

  @@index([targetWallet])
  @@index([userId])
}

model WalletTransaction {
  id             Int      @id @default(autoincrement())
  walletAddress  String   @map("wallet_address")
  chain          String   @default("eth")
  txHash         String   @map("tx_hash")
  txType         String   @map("tx_type")
  fromAddress    String?  @map("from_address")
  toAddress      String?  @map("to_address")
  tokenSymbol    String?  @map("token_symbol")
  tokenAddress   String?  @map("token_address")
  tokenInSymbol  String?  @map("token_in_symbol")
  tokenOutSymbol String?  @map("token_out_symbol")
  amount         String?
  valueUsd       Float?   @map("value_usd")
  blockNumber    BigInt?  @map("block_number")
  blockTimestamp DateTime @map("block_timestamp")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([txHash, walletAddress])
  @@index([walletAddress])
  @@index([blockTimestamp])
  @@index([chain])
  @@map("wallet_transactions")
}

model BillingUsageLedger {
  id                 String   @id @default(uuid())
  assistantMessageId String   @unique @map("assistant_message_id")
  userId             String   @map("user_id")
  model              String
  modelCategory      String   @map("model_category")
  promptTokens       Int      @default(0) @map("prompt_tokens")
  completionTokens   Int      @default(0) @map("completion_tokens")
  totalTokens        Int      @default(0) @map("total_tokens")
  toolCallsCount     Int      @default(0) @map("tool_calls_count")
  usdCost            Decimal  @default(0) @map("usd_cost") @db.Decimal
  dateUtc            DateTime @map("date_utc") @db.Date
  isFree             Boolean  @default(false) @map("is_free")
  createdAt          DateTime @default(now()) @map("created_at")
  user               User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([userId, dateUtc])
  @@index([modelCategory])
  @@map("billing_usage_ledger")
}

model DailyBilling {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  dateUtc       DateTime  @map("date_utc") @db.Date
  totalUsd      Decimal   @default(0) @map("total_usd") @db.Decimal
  tokenPriceUsd Decimal   @default(0) @map("token_price_usd") @db.Decimal
  tokensDue     Decimal   @default(0) @map("tokens_due") @db.Decimal
  tokenAddress  String    @map("token_address")
  chainId       Int       @map("chain_id")
  status        String    @default("pending")
  attempts      Int       @default(0)
  txHash        String?   @map("tx_hash")
  failureReason String?   @map("failure_reason")
  lastAttemptAt DateTime? @map("last_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, dateUtc])
  @@index([userId, dateUtc])
  @@map("daily_billing")
}

model BillingBlock {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  dateUtc   DateTime @map("date_utc") @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, dateUtc])
  @@index([userId, dateUtc])
  @@map("billing_blocks")
}

model BillingConsent {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  walletAddress String    @map("wallet_address")
  chainId       Int       @map("chain_id")
  authKeyId     String?   @map("auth_key_id")
  termsVersion  String    @map("terms_version")
  status        String    @default("active")
  consentedAt   DateTime  @default(now()) @map("consented_at")
  revokedAt     DateTime? @map("revoked_at")
  source        String?   @map("source")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, chainId])
  @@index([userId])
  @@map("billing_consents")
}

model PolymarketPosition {
  id            String                   @id @default(cuid())
  userId        String
  configId      String
  marketSlug    String
  conditionId   String
  assetId       String
  question      String
  outcome       String
  entryPrice    Float
  shares        Float
  costBasis     Float
  currentPrice  Float?
  profitLossPct Float?
  status        PolymarketPositionStatus @default(open)
  exitReason    String?
  createdAt     DateTime                 @default(now())
  closedAt      DateTime?
  resolvedAt    DateTime?
  config        PolymarketCopyConfig     @relation(fields: [configId], references: [id], onDelete: Cascade)
  user          User                     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([conditionId])
}

model PolymarketApiCreds {
  id            String   @id @default(cuid())
  userId        String   @unique
  walletAddress String
  apiKey        String
  apiSecret     String
  passphrase    String
  nonce         Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([walletAddress])
}

model PolymarketAction {
  id          String                 @id @default(cuid())
  userId      String
  type        String
  status      PolymarketActionStatus @default(pending)
  marketTitle String
  outcome     String
  assetId     String?
  orderId     String?
  txHash      String?
  size        Float?
  price       Float?
  amount      Float?
  error       String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Position {
  id                 String          @id @default(cuid())
  userId             String
  configId           String
  tokenAddress       String
  tokenSymbol        String?
  chainId            Int
  entryPrice         Float
  entryPriceDec      Decimal?        @db.Decimal(38, 18)
  entryAmount        String
  entryAmountDec     Decimal?        @db.Decimal(38, 18)
  entryTxHash        String
  entryUsdValue      Float
  entryUsdValueDec   Decimal?        @db.Decimal(38, 18)
  currentPrice       Float?
  currentPriceDec    Decimal?        @db.Decimal(38, 18)
  peakPrice          Float? // For dynamic TP
  priceHistory       Json?           @default("[]") // For ATR/Rapid decline
  dynamicTPTriggered Boolean?        @default(false)
  profitLossPct      Float?
  exitTxHash         String?
  exitReason         String?
  status             PositionStatus  @default(open)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  closedAt           DateTime?
  executionDelayMs   Int?
  exitAmount         String?
  exitAmountDec      Decimal?        @db.Decimal(38, 18)
  exitPrice          Float?
  exitPriceDec       Decimal?        @db.Decimal(38, 18)
  exitUsdValue       Float?
  exitUsdValueDec    Decimal?        @db.Decimal(38, 18)
  holdDurationHours  Float?
  leaderBuyAmount    Float?
  leaderBuyPrice     Float?
  leaderBuyValueUsd  Float?
  leaderTxHash       String?
  ourGasPriceGwei    Float?
  ourGasUsed         String?
  ourSlippageBps     Int?
  realizedPnlPct     Float?
  realizedPnlPctDec  Decimal?        @db.Decimal(38, 18)
  realizedPnlUsd     Float?
  realizedPnlUsdDec  Decimal?        @db.Decimal(38, 18)
  exitRetryCount     Int             @default(0)
  lastExitAttempt    DateTime?
  config             CopyTradeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, chainId, tokenAddress, leaderTxHash], map: "Position_user_chain_token_leaderTxHash_key")
  @@index([userId])
  @@index([configId])
  @@index([status])
  @@index([tokenAddress])
  @@index([entryTxHash])
  @@index([leaderTxHash])
  @@index([userId, chainId, tokenAddress, status])
  @@index([userId, chainId, tokenAddress, status, createdAt(sort: Desc)])
  @@index([status, exitRetryCount, lastExitAttempt])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String
  model     String        @default("grok-4-1-fast-reasoning")
  status    String        @default("active")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tasks     AITask[]
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([userId])
}

model ChatMessage {
  id                String         @id @default(cuid())
  sessionId         String
  role              String
  content           String
  reasoningContent  String?
  type              String         @default("text")
  data              String?
  transactionStatus String?
  transactionHash   String?
  citations         String?
  usage             String?
  toolCalls         String?
  toolCallId        String?
  messageIndex      Int
  status            String         @default("complete")
  createdAt         DateTime       @default(now())
  feedback          String?
  session           ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chunks            MessageChunk[]

  @@index([sessionId])
  @@index([messageIndex])
}

model AITask {
  id                 String      @id @default(cuid())
  sessionId          String
  userMessageId      String?
  assistantMessageId String?
  model              String
  status             String      @default("queued")
  errorMessage       String?
  toolContext        String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime    @default(now())
  session            ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
}

model MessageChunk {
  id               Int         @id @default(autoincrement())
  messageId        String
  chunkIndex       Int
  chunkType        String
  content          String?
  reasoningContent String?
  metadata         String?
  createdAt        DateTime    @default(now())
  message          ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, chunkIndex])
  @@index([messageId])
}

model NewsArticle {
  id              String    @id @default(cuid())
  title           String
  slug            String?   @unique
  summary         String?
  content         String
  coverImage      String?
  tokens          String?
  chains          String?
  status          String    @default("pending")
  rejectionReason String?
  paragraphId     String?
  paragraphUrl    String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model JudgeDecision {
  id               String    @id @default(cuid())
  tokenAddress     String
  tokenSymbol      String?
  tokenName        String?
  chainId          Int
  userAmountUsd    Float
  targetWallet     String?
  launchpadType    String
  liquidity        Float
  contractAgeHours Float
  userSizeLayer    Json
  liquidityLayer   Json
  structureLayer   Json
  stageLayer       Json
  tokenIntelLayer  Json
  finalDecision    String
  overallRiskScore Float
  slippageEstimate Float
  reasons          Json
  aiRationale      String?
  fullOutputJson   String
  actualExecuted   Boolean?
  actualProfitPct  Float?
  actualOutcome    String?
  outcomeNotes     String?
  outcomeUpdatedAt DateTime?
  analysisTimeMs   Int
  createdAt        DateTime  @default(now())

  @@index([tokenAddress])
  @@index([chainId])
  @@index([finalDecision])
  @@index([createdAt])
}

model FavoriteToken {
  id        String   @id @default(cuid())
  userId    String
  chain     String
  address   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, chain, address])
  @@index([userId])
}

model Cache {
  key       String    @id
  value     String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([expiresAt])
}

model MarketOverview {
  id                      Int      @id @default(autoincrement())
  globalMarketCap         Decimal?
  volume24h               Decimal?
  activeUsers             BigInt?
  ethGasPrice             String?  @db.VarChar(50)
  fearGreedIndex          Int?
  fearGreedClassification String?  @db.VarChar(50)
  bitcoinDominance        Decimal?
  altcoinSeasonIndex      Decimal?
  globalOpenInterest      Decimal?
  gasLevel                Decimal?
  gasLevelStatus          String?  @db.VarChar(20)
  bvix                    Decimal?
  evix                    Decimal?
  liquidityStressIndex    Decimal?
  liquidityStressStatus   String?  @db.VarChar(20)
  stablecoinsMcap         Decimal?
  btcDomChange24h         Decimal?
  mcapChange24h           Decimal?
  updatedAt               DateTime @default(now())
  createdAt               DateTime @default(now())

  @@index([updatedAt(sort: Desc)])
}

model ChainMetric {
  id            Int      @id @default(autoincrement())
  name          String   @unique @map("chain_name") @db.VarChar(50)
  tvl           Decimal?
  tvlChange24h  Decimal? @map("tvl_change_24h")
  volume24h     Decimal? @map("volume_24h")
  txns24h       BigInt?  @map("txns_24h")
  poolsCount    Int?     @map("pools_count")
  tokensCount   Int?     @map("tokens_count")
  activeWallets BigInt?  @map("active_wallets")
  gasPrice      String?  @map("gas_price") @db.VarChar(50)
  contracts24h  Int?
  contracts7d   Int?
  logoUrl       String?  @map("logo_url")
  updatedAt     DateTime @default(now()) @updatedAt
  createdAt     DateTime @default(now())

  @@index([updatedAt(sort: Desc)])
}

model ProtocolMetric {
  id           Int      @id @default(autoincrement())
  name         String   @unique @map("protocol_name") @db.VarChar(100)
  symbol       String?  @map("protocol_symbol") @db.VarChar(20)
  category     String?  @db.VarChar(50)
  tvl          Decimal?
  tvlChange1d  Decimal? @map("tvl_change_1d")
  tvlChange7d  Decimal? @map("tvl_change_7d")
  volume24h    Decimal? @map("volume_24h")
  chains       String[]
  mcapTvlRatio Decimal? @map("mcap_tvl_ratio")
  logoUrl      String?  @map("logo_url")
  updatedAt    DateTime @default(now()) @updatedAt
  createdAt    DateTime @default(now())

  @@index([category])
  @@index([updatedAt(sort: Desc)])
}

model TrendingToken {
  id             String    @id @default(cuid())
  chain          String    @default("eth")
  address        String
  name           String
  symbol         String
  imageUrl       String?   @map("image_url")
  creatorAddress String?   @map("creator_address")
  creatorUrl     String?   @map("creator_url")
  creatorLabel   String?   @map("creator_label")
  price          Decimal?
  priceChange5m  Decimal?  @map("price_change_5m")
  priceChange1h  Decimal?  @map("price_change_1h")
  priceChange6h  Decimal?  @map("price_change_6h")
  priceChange24h Decimal?  @map("price_change_24h")
  volume24h      Decimal?  @map("volume_24h")
  liquidity      Decimal?
  fdv            Decimal?
  rank           Int?
  updatedAt      DateTime  @default(now()) @updatedAt
  createdAt      DateTime  @default(now())
  poolCreatedAt  DateTime? @map("pool_created_at")
  launchpad      String?   @map("launchpad")

  @@unique([chain, address])
  @@index([rank])
  @@index([updatedAt(sort: Desc)])
}

model TokenLaunchBaseline {
  id            String   @id @default(cuid())
  chain         String
  address       String
  baselinePrice Decimal? @map("baseline_price")
  baselineSource String? @map("baseline_source")
  status        String   @default("pending")
  firstSeenAt   DateTime? @map("first_seen_at")
  lastCheckedAt DateTime? @map("last_checked_at")
  retryAfter    DateTime? @map("retry_after")
  attempts      Int      @default(0)
  lastError     String?  @map("last_error")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([chain, address])
  @@index([chain, status])
  @@index([updatedAt(sort: Desc)])
}

model TrendingCast {
  hash                String    @id @map("cast_hash")
  fid                 Int
  authorUsername      String?   @map("author_username")
  authorDisplayName   String?   @map("author_display_name")
  authorAvatar        String?   @map("author_avatar")
  authorVerified      Boolean   @default(false) @map("author_verified")
  text                String
  timestamp           DateTime
  embeds              Json?     @default("[]")
  parentCastFid       Int?      @map("parent_cast_fid")
  parentCastHash      String?   @map("parent_cast_hash")
  likes               Int       @default(0) @map("stats_likes")
  recasts             Int       @default(0) @map("stats_recasts")
  replies             Int       @default(0) @map("stats_replies")
  heatScore           Decimal?  @map("heat_score") @db.Decimal(10, 2)
  rank                Int?
  isBaseAppCoin       Boolean   @default(false) @map("is_base_app_coin")
  baseAppCoinMetadata Json?     @map("base_app_coin_metadata")
  coinValue           Decimal?  @map("coin_value")
  authorBio           String?   @map("author_bio")
  mentions            Json?     @default("[]")
  authorCreatorCoin   String?   @map("author_creator_coin")
  authorTwitter       String?   @map("author_twitter")
  statsLastUpdatedAt  DateTime? @map("stats_last_updated_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([statsLastUpdatedAt])
  @@index([timestamp])
  @@map("trending_casts")
}

model QualityFarcasterUser {
  id                 Int       @id @default(autoincrement())
  fid                Int       @unique
  username           String?   @db.VarChar(100)
  displayName        String?   @map("display_name") @db.VarChar(200)
  pfp                String?   @db.VarChar(500)
  bio                String?   @db.Text
  verifications      Json?     @default("[]")
  followers          Int       @default(0)
  following          Int       @default(0)
  totalCasts         Int       @default(0) @map("total_casts")
  engagementRate     Decimal   @default(0) @map("engagement_rate") @db.Decimal(10, 4)
  source             String?   @default("dune") @db.VarChar(50)
  isActive           Boolean   @default(true) @map("is_active")
  hasCreatorCoin     Boolean   @default(false) @map("has_creator_coin")
  creatorCoinAddress String?   @map("creator_coin_address") @db.VarChar(100)
  lastCoinCheck      DateTime? @map("last_coin_check")
  lastVerifiedAt     DateTime? @map("last_verified_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([fid])
  @@index([followers(sort: Desc)])
  @@index([isActive])
  @@map("quality_farcaster_users")
}

model TokenRule {
  id              Int       @id @default(autoincrement())
  userId          String    @map("user_id")
  chain           String    @default("base")
  address         String
  ruleType        String    @map("rule_type")
  conditionValue  Decimal   @map("condition_value")
  action          String
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  actionAmount    Float?    @map("action_amount")
  chainId         Int       @default(8453) @map("chain_id")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  targetType      String    @default("price") @map("target_type")

  @@map("token_rules")
}

model LeaderWalletStats {
  id               String    @id @default(cuid())
  address          String
  chainId          Int
  totalTrades      Int       @default(0)
  buyTrades        Int       @default(0)
  sellTrades       Int       @default(0)
  totalVolumeUsd   Float     @default(0)
  realizedPnlUsd   Float     @default(0)
  unrealizedPnlUsd Float     @default(0)
  totalPnlUsd      Float     @default(0)
  winCount         Int       @default(0)
  lossCount        Int       @default(0)
  winRate          Float     @default(0)
  bestTradePnl     Float     @default(0)
  worstTradePnl    Float     @default(0)
  avgTradePnl      Float     @default(0)
  firstTradeAt     DateTime?
  lastTradeAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([address, chainId])
  @@index([address])
  @@index([winRate])
}

model UserActivity {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @db.Date
  logins        Int      @default(0)
  chatMessages  Int      @default(0)
  swapsCount    Int      @default(0)
  swapVolumeUsd Float    @default(0)
  copyTrades    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model SwapHistory {
  id                String            @id @default(cuid())
  userId            String
  chainId           Int
  txHash            String?           @unique
  tokenInAddress    String
  tokenInSymbol     String?
  tokenInAmount     String
  tokenInAmountDec  Decimal?          @db.Decimal(38, 18)
  tokenInUsd        Float?
  tokenInUsdDec     Decimal?          @db.Decimal(38, 18)
  tokenOutAddress   String
  tokenOutSymbol    String?
  tokenOutAmount    String?
  tokenOutAmountDec Decimal?          @db.Decimal(38, 18)
  tokenOutUsd       Float?
  tokenOutUsdDec    Decimal?          @db.Decimal(38, 18)
  slippageBps       Int?
  status            SwapHistoryStatus @default(pending)
  failureReason     String?
  source            String            @default("manual")
  aiSessionId       String?
  createdAt         DateTime          @default(now())
  confirmedAt       DateTime?
  user              User              @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([userId])
  @@index([chainId])
  @@index([status])
  @@index([createdAt])
}

model UserReferral {
  id                   String    @id @default(cuid())
  referrerId           String
  refereeId            String    @unique
  referralCode         String
  rewardStatus         String    @default("pending")
  rewardAmount         Float?
  rewardedAt           DateTime?
  refereeSwapCount     Int       @default(0)
  refereeSwapVolumeUsd Float     @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([referrerId])
  @@index([referralCode])
}

model DataRetentionPolicy {
  id               String    @id @default(cuid())
  tableName        String    @unique
  retentionDays    Int
  isEnabled        Boolean   @default(true)
  lastCleanedAt    DateTime?
  lastCleanedCount Int?
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
