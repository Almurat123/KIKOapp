  @@index([kind])
  @@index([task_id])
}

model sandbox_job_events {
  id         String   @id
  task_id    String
  seq        Int
  phase      String?
  payload    Json
  created_at DateTime @default(now())
  AITask     AITask   @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([task_id, seq])
  @@index([task_id])
}

enum CopyTradeConfigStatus {
  active
  paused
}

enum PolymarketConfigStatus {
  active
  paused
}

enum PolymarketPositionStatus {
  open
  closed
  failed
}

enum PolymarketActionStatus {
  pending
  success
  failed
  cancelled
}

enum PositionStatus {
  pending
  pending_broadcast
  broadcasted_unseen
  open
  closing
  close_pending
  closed
  failed
  failed_final
}

enum SwapHistoryStatus {
  pending
  success
  failed
  confirmed
  cancelled
}

