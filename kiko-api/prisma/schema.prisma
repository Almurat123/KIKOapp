generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chain {
  id          Int      @id
  name        String   @unique
  symbol      String
  rpcUrl      String?
  explorerUrl String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}


model User {
  id                  String                 @id @default(cuid())
  privyDid            String                 @unique
  walletAddress       String                 @unique
  solanaWalletAddress String?
  farcasterFid        Int?
  farcasterUsername   String?
  createdAt           DateTime               @default(now())
  email               String?                @unique
  referralCode        String?                @unique
  referredBy          String?
  chatSessions        ChatSession[]
  configs             CopyTradeConfig[]
  favorites           FavoriteToken[]
  polymarketActions   PolymarketAction[]
  polymarketApiCreds  PolymarketApiCreds?
  polymarketConfigs   PolymarketCopyConfig[]
  polymarketPositions PolymarketPosition[]
  positions           Position[]
  swapHistory         SwapHistory[]
  userActivities      UserActivity[]
  settings            UserSettings?
  walletExports       WalletExport[]
  billingBlocks       BillingBlock[]
  billingConsents     BillingConsent[]
  billingUsage        BillingUsageLedger[]
  dailyBilling        DailyBilling[]
}

model WalletExport {
  id            String   @id @default(cuid())
  userId        String
  walletAddress String
  chainType     String
  exportedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, walletAddress])
  @@index([userId])
}

model UserSettings {
  id                            String   @id @default(cuid())
  userId                        String   @unique
  defaultSwapAmount             Float    @default(100)
  defaultSwapUnit               String   @default("native")
  checkTokenBeforeSwap          Boolean  @default(true)
  quickSwapMode                 Boolean  @default(false)
  swapMethod                    String   @default("allowance_trade")
  slippageMode                  String   @default("auto")
  customSlippage                Float    @default(0.5)
  mevProtection                 Boolean  @default(true)
  priceDeviationCheck           Boolean  @default(true)
  copyTradeAIMode               String   @default("disabled")
  fastSwapMode                  Boolean  @default(false)
  updatedAt                     DateTime @updatedAt
  createdAt                     DateTime @default(now())
  copyTradeTokenCooldownMinutes Int?     @default(60)
  minLiquidityUsd               Float?
  minMarketCapUsd               Float?
  minTargetValueUsd             Float?
  zoraNotificationThreshold     Int?     @default(5000)
  user                          User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)
}

model CopyTradeConfig {
  id                            String                @id @default(cuid())
  userId                        String
  targetWallet                  String
  chainId                       Int                   @default(8453)
  buyAmountUsd                  Float
  maxSlippageBps                Int                   @default(300)
  minMarketCapUsd               Float?
  minLiquidityUsd               Float?
  minTargetValueUsd             Float?
  takeProfitPct                 Float?
  stopLossPct                   Float?
  mirrorSell                    Boolean               @default(true)
  status                        CopyTradeConfigStatus @default(active)
  aiAnalysisMode                String                @default("disabled")
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  dynamicTPMinProfitPct         Float                 @default(100)
  enableDynamicTP               Boolean               @default(false)
  copyTradeTokenCooldownMinutes Int?
  disableTokenInfo              Boolean               @default(false)
  executionMode                 String                @default("normal")
  targetTrackedTxCount          Int                   @default(0)
  targetWalletTxCount           Int                   @default(0)
  targetBuyCount                Int                   @default(0)
  targetSellCount               Int                   @default(0)
  targetTokenSwapCount          Int                   @default(0)
  targetRealizedPnlUsd          Float                 @default(0)
  targetRealizedProfitUsd       Float                 @default(0)
  targetRealizedLossUsd         Float                 @default(0)
  targetUnrealizedPnlUsd        Float                 @default(0)
  targetTotalPnlUsd             Float                 @default(0)
  targetProfitUsd               Float                 @default(0)
  targetLossUsd                 Float                 @default(0)
  targetMetricsUpdatedAt        DateTime?
  configPayload                 Json?
  configHash                    String?
  configSignature               String?
  signerAddress                 String?
  signedNonce                   Int?
  signatureScheme               String                @default("eip712_v1")
  signatureVerifiedAt           DateTime?
  requiresResign                Boolean               @default(false)
  analyses                      CopyTradeAnalysis[]
  user                          User                  @relation(fields: [userId], references: [privyDid], onDelete: Cascade)
  positions                     Position[]

  @@index([targetWallet])
  @@index([userId])
}

model CopyTradeAnalysis {
  id              String          @id @default(cuid())
  configId        String
  tokenAddress    String
  tokenSymbol     String
  aiDecision      String
  confidenceScore Float
  analysisJson    String
  createdAt       DateTime        @default(now())
  config          CopyTradeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}

model TrackedWallet {
  address            String
  chainId            Int
  lastCheckedTx      String?
  activeConfigs      Int       @default(0)
  updatedAt          DateTime  @updatedAt
  lastTradeAt        DateTime?
  nickName           String?
  totalTradesTracked Int       @default(0)
  createdAt          DateTime  @default(now())

  @@id([address, chainId])
}

model PolymarketCopyConfig {
  id           String                 @id @default(cuid())
  userId       String
  targetWallet String
  betSizeUsd   Float                  @default(10)
  maxOpenBets  Int                    @default(10)
  status       PolymarketConfigStatus @default(active)
  mirrorSell   Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  user         User                   @relation(fields: [userId], references: [privyDid], onDelete: Cascade)
  positions    PolymarketPosition[]

  @@index([targetWallet])
  @@index([userId])
}

model WalletTransaction {
  id              Int      @id @default(autoincrement())
  walletAddress   String   @map("wallet_address")
  chain           String   @default("eth")
  txHash          String   @map("tx_hash")
  txType          String   @map("tx_type")
  fromAddress     String?  @map("from_address")
  toAddress       String?  @map("to_address")
  tokenSymbol     String?  @map("token_symbol")
  tokenAddress    String?  @map("token_address")
  tokenInSymbol   String?  @map("token_in_symbol")
  tokenOutSymbol  String?  @map("token_out_symbol")
  amount          String?
  valueUsd        Float?   @map("value_usd")
  blockNumber     BigInt?  @map("block_number")
  blockTimestamp  DateTime @map("block_timestamp")
  createdAt       DateTime @default(now()) @map("created_at")
  chainId         Int?     @map("chain_id")
  tokenInAddress  String?  @map("token_in_address")
  tokenOutAddress String?  @map("token_out_address")
  amountIn        String?  @map("amount_in")
  amountOut       String?  @map("amount_out")
  valueInUsd      Float?   @map("value_in_usd")
  valueOutUsd     Float?   @map("value_out_usd")
  parseReason     String?  @map("parse_reason")
  source          String?  @map("source")

  @@unique([txHash, walletAddress, chain])
  @@index([walletAddress])
  @@index([blockTimestamp])
  @@index([chain])
  @@index([chainId])
  @@map("wallet_transactions")
}

model BillingUsageLedger {
  id                 String   @id @default(uuid())
  assistantMessageId String   @unique @map("assistant_message_id")
  userId             String   @map("user_id")
  model              String
  modelCategory      String   @map("model_category")
  promptTokens       Int      @default(0) @map("prompt_tokens")
  completionTokens   Int      @default(0) @map("completion_tokens")
  totalTokens        Int      @default(0) @map("total_tokens")
  toolCallsCount     Int      @default(0) @map("tool_calls_count")
  usdCost            Decimal  @default(0) @map("usd_cost") @db.Decimal
  dateUtc            DateTime @map("date_utc") @db.Date
  isFree             Boolean  @default(false) @map("is_free")
  createdAt          DateTime @default(now()) @map("created_at")
  user               User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([userId, dateUtc])
  @@index([modelCategory])
  @@map("billing_usage_ledger")
}

model DailyBilling {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  dateUtc       DateTime  @map("date_utc") @db.Date
  totalUsd      Decimal   @default(0) @map("total_usd") @db.Decimal
  tokenPriceUsd Decimal   @default(0) @map("token_price_usd") @db.Decimal
  tokensDue     Decimal   @default(0) @map("tokens_due") @db.Decimal
  tokenAddress  String    @map("token_address")
  chainId       Int       @map("chain_id")
  status        String    @default("pending")
  attempts      Int       @default(0)
  txHash        String?   @map("tx_hash")
  failureReason String?   @map("failure_reason")
  lastAttemptAt DateTime? @map("last_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, dateUtc])
  @@index([userId, dateUtc])
  @@map("daily_billing")
}

model BillingBlock {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  dateUtc   DateTime @map("date_utc") @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, dateUtc])
  @@index([userId, dateUtc])
  @@map("billing_blocks")
}

model BillingConsent {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  walletAddress String    @map("wallet_address")
  chainId       Int       @map("chain_id")
  authKeyId     String?   @map("auth_key_id")
  termsVersion  String    @map("terms_version")
  status        String    @default("active")
  consentedAt   DateTime  @default(now()) @map("consented_at")
  revokedAt     DateTime? @map("revoked_at")
  source        String?   @map("source")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, chainId])
  @@index([userId])
  @@map("billing_consents")
}

model PolymarketPosition {
  id            String                   @id @default(cuid())
  userId        String
  configId      String
  marketSlug    String
  conditionId   String
  assetId       String
  question      String
  outcome       String
  entryPrice    Float
  shares        Float
  costBasis     Float
  currentPrice  Float?
  profitLossPct Float?
  status        PolymarketPositionStatus @default(open)
  exitReason    String?
  createdAt     DateTime                 @default(now())
  closedAt      DateTime?
  resolvedAt    DateTime?
  config        PolymarketCopyConfig     @relation(fields: [configId], references: [id], onDelete: Cascade)
  user          User                     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([conditionId])
}

model PolymarketApiCreds {
  id            String   @id @default(cuid())
  userId        String   @unique
  walletAddress String
  apiKey        String
  apiSecret     String
  passphrase    String
  nonce         Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([walletAddress])
}

model PolymarketAction {
  id          String                 @id @default(cuid())
  userId      String
  type        String
  status      PolymarketActionStatus @default(pending)
  marketTitle String
  outcome     String
  assetId     String?
  orderId     String?
  txHash      String?
  size        Float?
  price       Float?
  amount      Float?
  error       String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Position {
  id                 String          @id @default(cuid())
  userId             String
  configId           String
  tokenAddress       String
  tokenSymbol        String?
  chainId            Int
  entryPrice         Float
  entryAmount        String
  entryTxHash        String
  entryUsdValue      Float
  currentPrice       Float?
  profitLossPct      Float?
  exitTxHash         String?
  exitReason         String?
  status             PositionStatus  @default(open)
  createdAt          DateTime        @default(now())
  closedAt           DateTime?
  executionDelayMs   Int?
  exitAmount         String?
  exitPrice          Float?
  exitUsdValue       Float?
  holdDurationHours  Float?
  leaderBuyAmount    Float?
  leaderBuyPrice     Float?
  leaderBuyValueUsd  Float?
  leaderTxHash       String?
  ourGasPriceGwei    Float?
  ourGasUsed         String?
  ourSlippageBps     Int?
  realizedPnlPct     Float?
  realizedPnlUsd     Float?
  exitRetryCount     Int             @default(0)
  lastExitAttempt    DateTime?
  dynamicTPTriggered Boolean?        @default(false)
  peakPrice          Float?
  dynamicTPStopPrice Float?          // Ratcheted Chandelier stop (only moves up for longs)
  priceHistory       Json?           @default("[]")
  updatedAt          DateTime        @updatedAt
  entryPriceDec      Decimal?        @db.Decimal(38, 18)
  entryAmountDec     Decimal?        @db.Decimal(38, 18)
  entryAmountExact   String?         @map("entry_amount_exact")
  entryUsdValueDec   Decimal?        @db.Decimal(38, 18)
  currentPriceDec    Decimal?        @db.Decimal(38, 18)
  exitAmountDec      Decimal?        @db.Decimal(38, 18)
  exitAmountExact    String?         @map("exit_amount_exact")
  exitPriceDec       Decimal?        @db.Decimal(38, 18)
  exitUsdValueDec    Decimal?        @db.Decimal(38, 18)
  realizedPnlPctDec  Decimal?        @db.Decimal(38, 18)
  realizedPnlUsdDec  Decimal?        @db.Decimal(38, 18)
  config             CopyTradeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  pendingAttributed  PendingAttributedPosition?
  user               User            @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, chainId, tokenAddress, leaderTxHash], map: "Position_user_chain_token_leaderTxHash_key")
  @@index([userId])
  @@index([configId])
  @@index([status])
  @@index([tokenAddress])
  @@index([entryTxHash])
  @@index([leaderTxHash])
  @@index([userId, chainId, tokenAddress, status])
  @@index([userId, chainId, tokenAddress, status, createdAt(sort: Desc)])
  @@index([status, exitRetryCount, lastExitAttempt])
}

model PendingAttributedPosition {
  id                String    @id @default(cuid())
  positionId        String    @unique @map("position_id")
  userId            String    @map("user_id")
  chainId           Int       @map("chain_id")
  tokenAddress      String    @map("token_address")
  entryTxHash       String    @map("entry_tx_hash")
  leaderBuyTxHash   String?   @map("leader_buy_tx_hash")
  expectedAmountRaw String?   @map("expected_amount_raw")
  expectedAmountDec Decimal?  @map("expected_amount_dec") @db.Decimal(38, 18)
  status            String    @default("armed")
  reasonCode        String?   @map("reason_code")
  targetSellTxHash  String?   @map("target_sell_tx_hash")
  exitTxHash        String?   @map("exit_tx_hash")
  consumedAt        DateTime? @map("consumed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  position          Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId, chainId, tokenAddress, status])
  @@index([entryTxHash])
  @@index([targetSellTxHash])
  @@map("pending_attributed_positions")
}

model CopytradePositionLedger {
  id                      String    @id @default(cuid())
  userId                  String    @map("user_id")
  configId                String    @map("config_id")
  chainId                 Int       @map("chain_id")
  tokenAddress            String    @map("token_address")
  targetWallet            String    @map("target_wallet")
  leaderBuyTxHash         String?   @map("leader_buy_tx_hash")
  targetSellTxHash        String?   @map("target_sell_tx_hash")
  followerBuyTxHash       String?   @map("follower_buy_tx_hash")
  followerExitTxHash      String?   @map("follower_exit_tx_hash")
  lifecycleState          String    @map("lifecycle_state")
  targetFullExitVerified  Boolean   @default(false) @map("target_full_exit_verified")
  confirmedOwnedAmountRaw String?   @map("confirmed_owned_amount_raw")
  pendingOwnedAmountRaw   String?   @map("pending_owned_amount_raw")
  effectiveOwnedAmountRaw String?   @map("effective_owned_amount_raw")
  sellableAmountRaw       String?   @map("sellable_amount_raw")
  lastExecutionState      String?   @map("last_execution_state")
  lastExecutionReasonCode String?   @map("last_execution_reason_code")
  positionIdLegacy        String?   @unique @map("position_id_legacy")
  pendingLotIdLegacy      String?   @unique @map("pending_lot_id_legacy")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  closedAt                DateTime? @map("closed_at")

  @@unique([userId, configId, chainId, tokenAddress, leaderBuyTxHash], map: "copytrade_position_ledger_identity_key")
  @@index([userId, lifecycleState])
  @@index([targetWallet, chainId, tokenAddress])
  @@index([followerBuyTxHash])
  @@index([followerExitTxHash])
  @@map("copytrade_position_ledger")
}

model DirectSwapFeeExecution {
  id          String   @id @default(cuid())
  feeKey      String   @unique @map("fee_key")
  userId      String   @map("user_id")
  chainId     Int      @map("chain_id")
  sourceTxHash String  @map("source_tx_hash")
  mode        String
  feeToken    String   @map("fee_token")
  feeRecipient String  @map("fee_recipient")
  feeBps      Int      @map("fee_bps")
  feeAmount   String?  @map("fee_amount")
  feeTxHash   String?  @map("fee_tx_hash")
  status      String   @default("sending")
  attemptCount Int     @default(1) @map("attempt_count")
  lastError   String?  @map("last_error")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, chainId, createdAt(sort: Desc)], map: "idx_direct_swap_fee_exec_user_chain_created")
  @@index([sourceTxHash], map: "idx_direct_swap_fee_exec_source_tx_hash")
  @@index([status, updatedAt(sort: Desc)], map: "idx_direct_swap_fee_exec_status_updated")
  @@map("direct_swap_fee_execution")
}

model ChatSession {
  id                       String        @id @default(cuid())
  userId                   String
  title                    String
  model                    String        @default("grok-4-1-fast-reasoning")
  status                   String        @default("active")
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  lastResponseId           String?
  compactionCursor         String?
  conversationStateVersion Int           @default(1)
  tasks                    AITask[]
  messages                 ChatMessage[]
  user                     User          @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@index([userId])
}

model ChatMessage {
  id                String         @id @default(cuid())
  sessionId         String
  role              String
  content           String
  reasoningContent  String?
  type              String         @default("text")
  data              String?
  transactionStatus String?
  transactionHash   String?
  citations         String?
  usage             String?
  toolCalls         String?
  toolCallId        String?
  messageIndex      Int
  status            String         @default("complete")
  createdAt         DateTime       @default(now())
  feedback          String?
  compactedData     String?
  session           ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chunks            MessageChunk[]

  @@index([sessionId])
  @@index([messageIndex])
}

model AITask {
  id                 String               @id @default(cuid())
  sessionId          String
  userMessageId      String?
  assistantMessageId String?
  model              String
  status             String               @default("queued")
  errorMessage       String?
  toolContext        String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  executionMode      String               @default("standard")
  sandboxJobId       String?
  session            ChatSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sandbox_artifacts  sandbox_artifacts[]
  sandbox_job_events sandbox_job_events[]

  @@index([sessionId])
  @@index([status])
  @@index([sandboxJobId])
}

model MessageChunk {
  id               Int         @id @default(autoincrement())
  messageId        String
  chunkIndex       Int
  chunkType        String
  content          String?
  reasoningContent String?
  metadata         String?
  createdAt        DateTime    @default(now())
  message          ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, chunkIndex])
  @@index([messageId])
}

model NewsArticle {
  id              String    @id @default(cuid())
  title           String
  slug            String?   @unique
  summary         String?
  content         String
  coverImage      String?
  tokens          String?
  chains          String?
  status          String    @default("pending")
  rejectionReason String?
  paragraphId     String?
  paragraphUrl    String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model JudgeDecision {
  id               String    @id @default(cuid())
  tokenAddress     String
  tokenSymbol      String?
  tokenName        String?
  chainId          Int
  userAmountUsd    Float
  targetWallet     String?
  launchpadType    String
  liquidity        Float
  contractAgeHours Float
  userSizeLayer    Json
  liquidityLayer   Json
  structureLayer   Json
  stageLayer       Json
  tokenIntelLayer  Json
  finalDecision    String
  overallRiskScore Float
  slippageEstimate Float
  reasons          Json
  aiRationale      String?
  fullOutputJson   String
  actualExecuted   Boolean?
  actualProfitPct  Float?
  actualOutcome    String?
  outcomeNotes     String?
  outcomeUpdatedAt DateTime?
  analysisTimeMs   Int
  createdAt        DateTime  @default(now())

  @@index([tokenAddress])
  @@index([chainId])
  @@index([finalDecision])
  @@index([createdAt])
}

model FavoriteToken {
  id        String   @id @default(cuid())
  userId    String
  chain     String
  address   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [privyDid], onDelete: Cascade)

  @@unique([userId, chain, address])
  @@index([userId])
}

model Cache {
  key       String    @id
  value     String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([expiresAt])
}

model MarketOverview {
  id                      Int      @id @default(autoincrement())
  globalMarketCap         Decimal?
  volume24h               Decimal?
  activeUsers             BigInt?
  ethGasPrice             String?  @db.VarChar(50)
  fearGreedIndex          Int?
  fearGreedClassification String?  @db.VarChar(50)
  bitcoinDominance        Decimal?
  altcoinSeasonIndex      Decimal?
  globalOpenInterest      Decimal?
  gasLevel                Decimal?
  gasLevelStatus          String?  @db.VarChar(20)
  bvix                    Decimal?
  evix                    Decimal?
  liquidityStressIndex    Decimal?
  liquidityStressStatus   String?  @db.VarChar(20)
  updatedAt               DateTime @default(now())
  createdAt               DateTime @default(now())
  btcDomChange24h         Decimal?
  mcapChange24h           Decimal?
  stablecoinsMcap         Decimal?

  @@index([updatedAt(sort: Desc)])
}

model ChainMetric {
  id            Int      @id @default(autoincrement())
  name          String   @unique @map("chain_name") @db.VarChar(50)
  tvl           Decimal?
  tvlChange24h  Decimal? @map("tvl_change_24h")
  volume24h     Decimal? @map("volume_24h")
  txns24h       BigInt?  @map("txns_24h")
  poolsCount    Int?     @map("pools_count")
  tokensCount   Int?     @map("tokens_count")
  activeWallets BigInt?  @map("active_wallets")
  gasPrice      String?  @map("gas_price") @db.VarChar(50)
  contracts24h  Int?
  contracts7d   Int?
