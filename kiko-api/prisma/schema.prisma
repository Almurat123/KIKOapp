  sampleCount         Int           @default(0)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([chainId, tokenIn, tokenOut, side, isActive], map: "idx_exec_template_lookup")
  @@index([successRate, sampleCount], map: "idx_exec_template_quality")
}

model ExecutionSample {
