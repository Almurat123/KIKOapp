# Base mainnet deployment env for CreditTopUpRouter.
# Copy to `kiko-api/contracts.env` and fill the blanks before running:
#   npm run contracts:deploy:base-mainnet

# Required: Base mainnet RPC.
BASE_MAINNET_RPC_URL=

# Optional: enable source-code verification on BaseScan after deploy.
BASESCAN_API_KEY=
CREDIT_ROUTER_VERIFY=false

# Required: deployer private key for the wallet that will send the deploy tx.
# Do not commit the real value.
CREDIT_ROUTER_DEPLOYER_PRIVATE_KEY=

# Required: onchain governance / owner address for the router.
CREDIT_ROUTER_OWNER_ADDRESS=

# Required: treasury that receives deposits immediately.
CREDIT_ROUTER_TREASURY_ADDRESS=

# Optional: refund operator. Defaults to owner if blank.
CREDIT_ROUTER_REFUND_AUTHORITY_ADDRESS=

# Optional: defaults to 86400 (24h).
CREDIT_ROUTER_REFUND_WINDOW_SECONDS=86400

# Required for production config. Fill the Base token addresses you want enabled.
CREDIT_ROUTER_USDC_ADDRESS=
CREDIT_ROUTER_USDT_ADDRESS=
CREDIT_ROUTER_KIKO_ADDRESS=

# Token refund toggles. v1 product rule is refund-enabled for all supported assets.
CREDIT_ROUTER_USDC_REFUNDS_ENABLED=true
CREDIT_ROUTER_USDT_REFUNDS_ENABLED=true
CREDIT_ROUTER_KIKO_REFUNDS_ENABLED=true

# Optional: keep true to print the API env block after deployment.
CREDIT_ROUTER_PRINT_RUNTIME_ENV=true

# Optional: set true to validate env and print the exact actions without broadcasting.
CREDIT_ROUTER_DRY_RUN=false
