# Server Configuration
PORT=3001
NODE_ENV=development

# Redis Configuration
REDIS_ENABLED=true
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Keys
COINGECKO_API_KEY=your_coingecko_api_key_here
DEFILLAMA_API_KEY=your_defillama_api_key_here
ALTERNATIVE_API_KEY=your_alternative_api_key_here
DUNE_API_KEY=your_dune_api_key_here
SIM_DUNE_API_KEY=your_sim_dune_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
NEWSAPI_API_KEY=your_newsapi_api_key_here
CRYPTOCOMPARE_API_KEY=
# CryptoCompare API key for crypto news aggregation (OPTIONAL - works without key with rate limits)
# Get your free API key from: https://min-api.cryptocompare.com/
# Free tier: 100,000 calls/month
# Used for: High-quality crypto news from multiple sources

ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
# Note: Alpha Vantage is optional. Free tier available at https://www.alphavantage.co/support/#api-key

FRED_API_KEY=your_fred_api_key_here
# FRED API key for economic indicators (CPI, PPI, GDP, Unemployment Rate, etc.)
# Get your free API key from: https://fred.stlouisfed.org/docs/api/api_key.html
# Documentation: https://fred.stlouisfed.org/docs/api/fred/

# Security Scanning API Keys
GOPLUS_API_KEY=
# GoPlus Security API key for token security scanning (OPTIONAL - may work without key for limited usage)
# Get your API key from: https://docs.gopluslabs.io/
# Documentation: https://docs.gopluslabs.io/reference/getscanresultusingget
# Note: API key is recommended for higher rate limits, but may work without it for basic usage.

ETHERSCAN_API_KEY=
# Etherscan API key for ETH gas price and contract source code
# Get your free API key from: https://etherscan.io/apis
# Free tier: 5 calls/second, 100,000 calls/day (more than enough!)
# 
# Used for:
# - Real-time ETH gas price (SafeGasPrice, ProposeGasPrice, FastGasPrice)
# - Contract source code fetching
# 
# Note: Works without key but with lower rate limits. Key recommended for production.

ALCHEMY_API_KEY=
# Alchemy API key for wallet transactions, balances, and token transfers
# Get your free API key from: https://dashboard.alchemy.com/
# Required for wallet monitoring features (Follow page)
# Supported chains: Ethereum, Base, Arbitrum, Optimism, Polygon

ALCHEMY_AUTH_TOKEN=
# Alchemy dashboard auth token used for webhook address management (PATCH /api/update-webhook-addresses)

ALCHEMY_WEBHOOK_ID_ETH=
# Ethereum Mainnet Address Activity webhook ID

ALCHEMY_WEBHOOK_ID_BASE=
# Base Address Activity webhook ID

ALCHEMY_WEBHOOK_ID_BSC=
# BSC Address Activity webhook ID

ALCHEMY_WEBHOOK_ID_SOL=
# Solana Address Activity webhook ID

ALCHEMY_WEBHOOK_SECRET=
# Legacy global Alchemy webhook signing key for all networks

ALCHEMY_WEBHOOK_SECRET_ETH=
# Ethereum-specific Alchemy webhook signing key

ALCHEMY_WEBHOOK_SECRET_BASE=
# Base-specific Alchemy webhook signing key

ALCHEMY_WEBHOOK_SECRET_BSC=
# BSC-specific Alchemy webhook signing key

ALCHEMY_WEBHOOK_SECRET_SOL=
# Solana-specific Alchemy webhook signing key

# ============================================
# Copytrade Emergency Guards
# ============================================
# Background sweep interval (milliseconds)
COPYTRADE_ORPHAN_SWEEP_INTERVAL_MS=600000

ZERION_API_KEY=
# Zerion API key for wallet-level PNL (supports EVM + Solana via wallet endpoint)
# Get your key from: https://developers.zerion.io/
# Used for: fast wallet-level PNL summary (primary provider in Wallet PNL tool)

ZEROX_API_KEY=
# 0x API key for swap quotes and token prices
# Get your free API key from: https://0x.org/docs/api
# Documentation: https://0x.org/docs/api
# Free tier: 100,000 requests/month
# Used for: Token swap quotes, price data, and DEX aggregation
# Note: Works without key but with lower rate limits. Key recommended for production.

JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
# Jupiter Metis/Swap base URL for Solana swaps
# Documentation: https://dev.jup.ag/api-reference/swap
# Used for: Solana token swaps via Jupiter public Metis/Swap API

# ============================================
# Clanker Token Deployment
# ============================================
# Clanker v4 token deployment and reward/fee lookup API.
# Used by ClankerSkill tools for /api/tokens/deploy, admin/deployer history,
# and beta claimed-fee history. Do not expose this key to the frontend.
CLANKER_API_KEY=
CLANKER_API_BASE_URL=https://www.clanker.world
# Optional RPC override for Clanker v4 on-chain reward reads.
CLANKER_RPC_URL=

# ============================================
# Privy Session Signer (required for authorization UI)
# ============================================
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
PRIVY_AUTHORIZATION_KEY_ID=

# Policy IDs from Privy Dashboard -> Session Signers
PRIVY_POLICY_ID_AUTOTRADE_EVM=
PRIVY_POLICY_ID_AUTOTRADE_SOLANA=

# Optional billing policy
PRIVY_POLICY_ID_BILLING_EVM=

# ============================================
# X Bot / Webhook Security
# ============================================
# 32-character encryption key required to persist X bot OAuth credentials safely.
# Production will refuse to start X OAuth without this.
ENCRYPTION_KEY=

# OAuth2 app credentials for the existing X app
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=https://api.kikoapp.app/api/auth/x/callback
X_OAUTH1_CALLBACK_URI=https://api.kikoapp.app/api/auth/x/oauth1/callback

# Only these Privy DIDs are allowed to initiate bot authorization.
# Comma-separated if more than one operator is truly required.
X_BOT_AUTHORIZED_PRIVY_DIDS=

# Expected official X bot identity. Authorization will fail if the returned
# X account does not match this username, and optionally this numeric user id.
X_BOT_USERNAME=kikoapp
X_BOT_USER_ID=

# Webhook ingress
X_INGRESS_ENABLED=true
X_INGRESS_MODE=webhook
# Must be the X app API Secret / Consumer Secret used for CRC + signature
# verification. Do NOT use the OAuth2 Client Secret here.
X_WEBHOOK_SECRET=
X_WEBHOOK_CALLBACK_URL=https://api.kikoapp.app/api/webhook/x
X_WEBHOOK_RECOVERY_MS=10000
X_LINK_BASE_URL=https://kikoapp.app/settings
X_SHARE_BASE_URL=https://api.kikoapp.app/x/share

# Runtime bot token fallback (optional). Prefer the OAuth callback storage path
# over manually setting these in production.
X_BOT_ACCESS_TOKEN=

# OAuth1 user-context credentials for Account Activity subscription management.
# These must belong to the official bot account being subscribed, not your personal account.
X_CONSUMER_KEY=
X_OAUTH1_ACCESS_TOKEN=
X_OAUTH1_ACCESS_TOKEN_SECRET=

# Out-of-band operator token for X webhook management. Do NOT expose this to the
# frontend, and do not keep it in runtime env unless a management script needs it.
X_APP_BEARER_TOKEN=

# CryptoCompare and RSS feeds work without API keys

# ============================================
# Judge Engine Configuration
# ============================================
# Set to 'true' to globally disable the AI Judge Engine (token risk analysis)
# When disabled, all swaps will be allowed without AI risk assessment
# User-level control is available via 'checkTokenBeforeSwap' setting
# DISABLE_JUDGE_ENGINE=false

# ============================================
# Dune Analytics Configuration
# ============================================
# 
# ⚠️  IMPORTANT: Dune free tier has limited credits (2,500 datapoints/month)
# The system is configured to:
# - Only refresh Dune data once per day (3:00 AM UTC via cron job)
# - NOT call Dune on every API request (uses database cache instead)
# - Skip Dune refresh on server startup to save credits
# 
# Chain Metrics Query IDs (comma-separated)
# Provides: chain, txns_24h, active_wallets, gas_price, volume_24h
# 
# Available queries:
# - EVM chains:     6250722 (46 EVM chains metrics)
# - Non-EVM chains: 6240250 (Aptos, Starknet, Tron, Bitcoin, Near)
# - Solana:         6254391 (Solana-specific metrics with volume)
#
# Example: DUNE_CHAIN_METRICS_QUERY_ID=6250722,6240250,6254391
DUNE_CHAIN_METRICS_QUERY_ID=6250722,6240250,6254391

# Smart Contracts Query ID
# Provides: chain, new_contracts_24h, new_contracts_7d
# Query ID: 6256459 (EVM chains smart contract deployments)
DUNE_CONTRACTS_QUERY_ID=6256459

# ============================================
# Legacy Configuration (optional)
# ============================================
# Unified query for market overview + chains (if using single query approach)
DUNE_UNIFIED_MARKET_QUERY_ID=

# Separate queries for market overview and chains data
DUNE_MARKET_OVERVIEW_QUERY_ID=
DUNE_CHAINS_DATA_QUERY_ID=

# ============================================
# Farcaster / Social Data Configuration
# ============================================
# Neynar API Key for Farcaster trending feed
# Get your API key from: https://neynar.com
# 
# API Documentation: https://docs.neynar.com/reference/fetch-trending-feed
# 
# ⚠️  IMPORTANT: Trending feed endpoint requires a PAID plan
# Free tier does NOT support trending feed endpoint
# See pricing: https://neynar.com/#pricing
# 
# If not set, the system will use mock data for development
NEYNAR_API_KEY=your_neynar_api_key_here

# Neynar signer UUID for publishing Farcaster replies
# Get this from the Neynar dashboard for the signer you want to publish with
# This is separate from the webhook secret
NEYNAR_SIGNER_UUID=your_neynar_signer_uuid_here

# CORS (comma-separated allowed origins)
CORS_ORIGIN=

# ============================================
# Chat Image Uploads (Cloudflare R2)
# ============================================
# Required for web chat image upload -> model input flow.
# Images are stored temporarily in R2 and are not written into the main DB.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional override. Defaults to:
# https://<CLOUDFLARE_R2_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=

# Optional upload behavior overrides
CHAT_IMAGE_UPLOAD_PREFIX=chat-uploads
CHAT_IMAGE_UPLOAD_PREPARED_TTL_SECONDS=900
CHAT_IMAGE_UPLOAD_TASK_TTL_SECONDS=3600
CHAT_IMAGE_UPLOAD_PUT_TTL_SECONDS=300
CHAT_IMAGE_UPLOAD_GET_TTL_SECONDS=3600
CHAT_IMAGE_UPLOAD_CACHE_CONTROL=private, max-age=3600

# ============================================
# Chat Worker (streaming + tool limits)
# ============================================
# Max concurrent chat tasks processed by worker
CHAT_WORKER_MAX_CONCURRENCY=3
# Max total tool calls allowed per task before stopping
CHAT_WORKER_MAX_TOOL_CALLS=12
# Max calls allowed per individual tool per task
CHAT_WORKER_MAX_TOOL_CALLS_PER_TOOL=3
# Show canonical-intent normalization reasoning in the same assistant reasoning
# surface so the UI has visible runtime feedback while routing is in progress.
# Defaults to enabled when unset. Set to false only if you explicitly want to
# hide routing-phase reasoning.
CHAT_EXPOSE_NORMALIZATION_REASONING=
# Unified orchestrator mode (unified|legacy). unified includes context budgeting + model gateway.
CHAT_ORCHESTRATOR_MODE=unified
# Context budget controls for model input compaction
CHAT_CONTEXT_RECENT_WINDOW=12
CHAT_CONTEXT_MAX_INPUT_TOKENS=16000
CHAT_CONTEXT_RESERVED_OUTPUT_TOKENS=3500

# ============================================
# Logging (Noise Control)
# ============================================
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Suppress repeated logger.throttled(code+message) logs within this window
LOG_THROTTLE_WINDOW_MS=5000
# Flush interval for logger.aggregate summaries (15 minutes)
LOG_AGGREGATE_INTERVAL_MS=900000
# Global stdout/stderr cap to prevent log storms on Railway
LOG_MAX_PER_SECOND=60
# Emit one dropped-log summary every N ms when capped
LOG_DROP_SUMMARY_INTERVAL_MS=10000
# Route stray console.log/warn/error through structured logger
LOG_INTERCEPT_CONSOLE=true

# External baseline fetch concurrency (EVM)
BASELINE_EXTERNAL_CONCURRENCY=8
# External baseline fetch concurrency (Solana, keep low)
BASELINE_EXTERNAL_CONCURRENCY_SOL=2

# ============================================
# Platform Fees (optional)
# ============================================
# Enable platform fees for swaps (0x affiliate fee on EVM, SOL-transfer fee for Solana SOL-in swaps)
PLATFORM_FEES_ENABLED=false

# Fee rates in basis points:
# - 50 = 0.5%
# - 100 = 1%
PLATFORM_FEE_SWAP_BPS=50
PLATFORM_FEE_COPY_TRADE_BPS=100
# CopyTrade fee when AI analysis is enabled for a specific copytrade config
PLATFORM_FEE_COPY_TRADE_AI_BPS=150

# EVM fee recipient (0x affiliateAddress for 0x Swap API)
PLATFORM_FEE_EVM_RECIPIENT=0x0000000000000000000000000000000000000000

# Solana fee recipient (base58). Used only when tokenInMint is SOL/WSOL and we charge a lamports transfer first.
PLATFORM_FEE_SOLANA_RECIPIENT=

# ============================================
# Billing and Model Quotas
# ============================================
BILLING_ENABLED=true
BILLING_CHAIN_ID=8453
BILLING_TOKEN_ADDRESS=
BILLING_TOKEN_DECIMALS=18
# Fallback premium quota when token-tier chat quotas are disabled or token
# gating is not configured. GPT and Grok share this one daily quota.
BILLING_DAILY_FREE_PREMIUM=8
# Fallback shared daily cap for all free models when token tiers do not define
# one. 0 means unlimited at KIKO level.
BILLING_DAILY_FREE_MODEL_LIMIT=0
# Generated-image free outputs per authenticated user per UTC day.
# This controls the Grok normal image free allowance.
GENERATED_IMAGE_DAILY_FREE_OUTPUTS=2

# Model categorization (comma-separated lists)
BILLING_FREE_MODELS=kimi-k2-5-reasoning,kimi-k2-5-instant
BILLING_PREMIUM_MODELS=gpt-5.4-mini-2026-03-17,gpt-4.1,grok-4-1-fast-reasoning,grok-4-1-fast-non-reasoning

# Custom Pricing JSON (optional override for token-based billing)
# BILLING_MODEL_PRICING_JSON={"model-name": {"promptUsdPer1M": 0.20, "completionUsdPer1M": 0.50}}

# ============================================
# Credits Billing Runtime
# ============================================
# Credits product rules
CREDITS_PER_USD=10
CREDITS_MINIMUM_TOPUP_USD=1
CREDITS_REFUND_WINDOW_HOURS=24
CREDITS_DAILY_PREMIUM_FREE_MESSAGES=5
CREDITS_LIFETIME_IMAGE_FREE_REQUESTS=3
CREDITS_MIN_PREMIUM_TEXT_RESERVE=1

# Deposit reconciliation / chain ingestion
CREDITS_RECONCILIATION_INTERVAL_MINUTES=5
CREDITS_RECONCILIATION_BACKFILL_BLOCKS=2000
CREDITS_RECONCILIATION_OVERLAP_BLOCKS=20

# Top-up rail mode
# treasury_transfer: old direct-to-treasury watcher flow
# router_contract: new CreditTopUpRouter contract flow
CREDITS_TOPUP_MODE=router_contract

# Base deposit endpoints used by the backend and UI
CREDITS_BASE_TREASURY_ADDRESS=
CREDITS_TOPUP_ROUTER_ADDRESS=
CREDITS_REFUND_OPERATOR_ADDRESS=

# Base supported asset addresses
CREDITS_BASE_USDC_ADDRESS=
CREDITS_BASE_USDC_DECIMALS=6
CREDITS_BASE_USDC_CONFIRMATIONS=3

CREDITS_BASE_USDT_ADDRESS=
CREDITS_BASE_USDT_DECIMALS=6
CREDITS_BASE_USDT_CONFIRMATIONS=3

CREDITS_BASE_KIKO_ADDRESS=
CREDITS_BASE_KIKO_DECIMALS=18
CREDITS_BASE_KIKO_CONFIRMATIONS=3

# Optional pricing overrides
# CREDITS_TEXT_PRICING_JSON={"gpt-5.4-mini-2026-03-17":{"baseCreditsPerMessage":0.2,"inputCreditsPer1kTokens":0.05,"outputCreditsPer1kTokens":0.12}}
# CREDITS_IMAGE_PRICING_JSON={"gpt-image-1-mini":{"low":0.15,"medium":0.33,"high":1.08}}

# ============================================
# Usage Limits (token-holder chat quota tiers)
# ============================================
USAGE_LIMITS_ENABLED=true
USAGE_LIMITS_CHAIN_ID=8453
USAGE_LIMITS_TOKEN_ADDRESS=
USAGE_LIMITS_TOKEN_DECIMALS=18
USAGE_LIMIT_CACHE_TTL_MS=86400000

# Legacy base premium limit alias. If a tier only defines `dailyLimit`, chat
# premium quota will still use that value for backward compatibility.
USAGE_LIMITS_BASE_DAILY_LIMIT=15

# Tiers JSON: array of {minBalance, freeModelLimit, premiumLimit}
# `dailyLimit` remains supported as a legacy alias for `premiumLimit`.
# Example:
# USAGE_LIMITS_TIERS_JSON=[{"minBalance":0,"freeModelLimit":0,"premiumLimit":8},{"minBalance":10000000,"freeModelLimit":50,"premiumLimit":12},{"minBalance":50000000,"freeModelLimit":200,"premiumLimit":20}]
USAGE_LIMITS_TIERS_JSON=
