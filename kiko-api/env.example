# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://almurat@localhost:5432/kiko_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Keys
COINGECKO_API_KEY=your_coingecko_api_key_here
DEFILLAMA_API_KEY=your_defillama_api_key_here
ALTERNATIVE_API_KEY=your_alternative_api_key_here
DUNE_API_KEY=your_dune_api_key_here
SIM_DUNE_API_KEY=your_sim_dune_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
NEWSAPI_API_KEY=your_newsapi_api_key_here
CRYPTOCOMPARE_API_KEY=
# CryptoCompare API key for crypto news aggregation (OPTIONAL - works without key with rate limits)
# Get your free API key from: https://min-api.cryptocompare.com/
# Free tier: 100,000 calls/month
# Used for: High-quality crypto news from multiple sources

ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
# Note: Alpha Vantage is optional. Free tier available at https://www.alphavantage.co/support/#api-key

FRED_API_KEY=your_fred_api_key_here
# FRED API key for economic indicators (CPI, PPI, GDP, Unemployment Rate, etc.)
# Get your free API key from: https://fred.stlouisfed.org/docs/api/api_key.html
# Documentation: https://fred.stlouisfed.org/docs/api/fred/

# Security Scanning API Keys
GOPLUS_API_KEY=
# GoPlus Security API key for token security scanning (OPTIONAL - may work without key for limited usage)
# Get your API key from: https://docs.gopluslabs.io/
# Documentation: https://docs.gopluslabs.io/reference/getscanresultusingget
# Note: API key is recommended for higher rate limits, but may work without it for basic usage.

ETHERSCAN_API_KEY=
# Etherscan API key for ETH gas price and contract source code
# Get your free API key from: https://etherscan.io/apis
# Free tier: 5 calls/second, 100,000 calls/day (more than enough!)
# 
# Used for:
# - Real-time ETH gas price (SafeGasPrice, ProposeGasPrice, FastGasPrice)
# - Contract source code fetching
# 
# Note: Works without key but with lower rate limits. Key recommended for production.

ALCHEMY_API_KEY=
# Alchemy API key for wallet transactions, balances, and token transfers
# Get your free API key from: https://dashboard.alchemy.com/
# Required for wallet monitoring features (Follow page)
# Supported chains: Ethereum, Base, Arbitrum, Optimism, Polygon

ZEROX_API_KEY=
# 0x API key for swap quotes and token prices
# Get your free API key from: https://0x.org/docs/api
# Documentation: https://0x.org/docs/api
# Free tier: 100,000 requests/month
# Used for: Token swap quotes, price data, and DEX aggregation
# Note: Works without key but with lower rate limits. Key recommended for production.

JUPITER_API_KEY=
# Jupiter Ultra Swap API key for Solana swaps
# Get your API key from: https://dev.jup.ag/get-started
# Documentation: https://dev.jup.ag/get-started
# Used for: Solana token swaps via Jupiter Ultra Swap API
# Note: API key is recommended for higher rate limits and better performance

# CryptoCompare and RSS feeds work without API keys

# ============================================
# Judge Engine Configuration
# ============================================
# Set to 'true' to globally disable the AI Judge Engine (token risk analysis)
# When disabled, all swaps will be allowed without AI risk assessment
# User-level control is available via 'checkTokenBeforeSwap' setting
# DISABLE_JUDGE_ENGINE=false

# ============================================
# Dune Analytics Configuration
# ============================================
# 
# ⚠️  IMPORTANT: Dune free tier has limited credits (2,500 datapoints/month)
# The system is configured to:
# - Only refresh Dune data once per day (3:00 AM UTC via cron job)
# - NOT call Dune on every API request (uses database cache instead)
# - Skip Dune refresh on server startup to save credits
# 
# Chain Metrics Query IDs (comma-separated)
# Provides: chain, txns_24h, active_wallets, gas_price, volume_24h
# 
# Available queries:
# - EVM chains:     6250722 (46 EVM chains metrics)
# - Non-EVM chains: 6240250 (Aptos, Starknet, Tron, Bitcoin, Near)
# - Solana:         6254391 (Solana-specific metrics with volume)
#
# Example: DUNE_CHAIN_METRICS_QUERY_ID=6250722,6240250,6254391
DUNE_CHAIN_METRICS_QUERY_ID=6250722,6240250,6254391

# Smart Contracts Query ID
# Provides: chain, new_contracts_24h, new_contracts_7d
# Query ID: 6256459 (EVM chains smart contract deployments)
DUNE_CONTRACTS_QUERY_ID=6256459

# ============================================
# Legacy Configuration (optional)
# ============================================
# Unified query for market overview + chains (if using single query approach)
DUNE_UNIFIED_MARKET_QUERY_ID=

# Separate queries for market overview and chains data
DUNE_MARKET_OVERVIEW_QUERY_ID=
DUNE_CHAINS_DATA_QUERY_ID=

# ============================================
# Farcaster / Social Data Configuration
# ============================================
# Neynar API Key for Farcaster trending feed
# Get your API key from: https://neynar.com
# 
# API Documentation: https://docs.neynar.com/reference/fetch-trending-feed
# 
# ⚠️  IMPORTANT: Trending feed endpoint requires a PAID plan
# Free tier does NOT support trending feed endpoint
# See pricing: https://neynar.com/#pricing
# 
# If not set, the system will use mock data for development
NEYNAR_API_KEY=your_neynar_api_key_here

# CORS
CORS_ORIGIN=http://localhost:5173

# ============================================
# Chat Worker (streaming + tool limits)
# ============================================
# Max concurrent chat tasks processed by worker
CHAT_WORKER_MAX_CONCURRENCY=3
# Max total tool calls allowed per task before stopping
CHAT_WORKER_MAX_TOOL_CALLS=12
# Max calls allowed per individual tool per task
CHAT_WORKER_MAX_TOOL_CALLS_PER_TOOL=3

# ============================================
# Platform Fees (optional)
# ============================================
# Enable platform fees for swaps (0x affiliate fee on EVM, SOL-transfer fee for Solana SOL-in swaps)
PLATFORM_FEES_ENABLED=false

# Fee rates in basis points:
# - 50 = 0.5%
# - 100 = 1%
PLATFORM_FEE_SWAP_BPS=50
PLATFORM_FEE_COPY_TRADE_BPS=100

# EVM fee recipient (0x affiliateAddress for 0x Swap API)
PLATFORM_FEE_EVM_RECIPIENT=0x0000000000000000000000000000000000000000

# Solana fee recipient (base58). Used only when tokenInMint is SOL/WSOL and we charge a lamports transfer first.
PLATFORM_FEE_SOLANA_RECIPIENT=
